{
  "category": "navigation",
  "description": "Breadcrumb — a labelled nav with an ordered trail, aria-hidden separators, and the current page marked aria-current.",
  "markup": "<nav class=\"ui-kit ui-bc\" aria-label=\"Breadcrumb\">\n  <style>\n    .ui-bc { font-family: var(--font-family-body); font-size: var(--font-size-sm); }\n    .ui-bc__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }\n    .ui-bc__link { color: var(--color-muted-foreground); text-decoration: none; border-radius: var(--radius-sm); transition: color var(--duration-fast) ease; text-underline-position: from-font; text-decoration-skip-ink: auto; }\n    /* Touch floor: real :hover only where hover exists — on touch it sticks after a tap. */\n    @media (hover: hover) { .ui-bc__link:hover { color: var(--color-foreground); text-decoration: underline; } }\n    .ui-bc__link:focus-visible { outline: 2px solid var(--color-ring); outline-offset: 2px; color: var(--color-foreground); }\n    .ui-bc__sep { color: var(--color-muted-foreground); user-select: none; }\n    .ui-bc__current { color: var(--color-foreground); font-weight: var(--font-weight-medium); }\n  </style>\n  <ol class=\"ui-bc__list\">\n    <li><a class=\"ui-bc__link\" href=\"#\">Home</a></li>\n    <li class=\"ui-bc__sep\" aria-hidden=\"true\">/</li>\n    <li><a class=\"ui-bc__link\" href=\"#\">Design systems</a></li>\n    <li class=\"ui-bc__sep\" aria-hidden=\"true\">/</li>\n    <li><a class=\"ui-bc__link\" href=\"#\">Aurora</a></li>\n    <li class=\"ui-bc__sep\" aria-hidden=\"true\">/</li>\n    <li><span class=\"ui-bc__current\" aria-current=\"page\">Tokens</span></li>\n  </ol>\n</nav>",
  "name": "Structure/Breadcrumb",
  "scope": "local",
  "status": "stable",
  "tokensUsed": [
    "color.muted-foreground",
    "color.foreground",
    "color.ring",
    "radius.sm",
    "font-family.body",
    "font-weight.medium",
    "font-size.sm",
    "space.2",
    "duration.fast"
  ],
  "variants": [
    "State=Static"
  ]
}
