    "font-weight.medium",
    "font-size.xs",
    "font-size.sm",
    "space.1",
    "space.2",
    "space.3",
    "space.4",
    "space.16",
    "duration.fast"
  ],
  "variants": [
    "State=Default",
    "State=Hover",
    "State=Focus",
    "State=Invalid",
    "State=Disabled"
  ]
}
